# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Exposed to the browser via Vite (must be prefixed with VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# PRODUCTION / VERCEL — use port 6543 (PgBouncer, transaction mode).
# Prevents serverless functions exhausting PostgreSQL's connection limit.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true
#
# MIGRATIONS — use the session-mode pooler (same host, port 5432).
# Newer Supabase projects don't expose the direct host without an IPv4 add-on.
# Session mode supports DDL; transaction mode (6543) does not.
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── NUSMods ──────────────────────────────────────────────────────────────────
# Update this each academic year. Format: "YYYY-YYYY"
NUSMODS_ACADEMIC_YEAR=2025-2026

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS — set to your deployed Vercel client URL in production
CLIENT_URL=http://localhost:5173

# ─── Client ───────────────────────────────────────────────────────────────────
# URL of the backend API (change to deployed server URL in production)
VITE_API_URL=http://localhost:3001
